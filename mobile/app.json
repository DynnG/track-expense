{
  "expo": {
    "name": "Track Expense",
    "slug": "track-expense-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/expense-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dynng.trackexpense"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/expense-icon.png",
        "backgroundColor": "#4164ed"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dynng.trackexpense",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/expense-icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-router",
      "expo-splash-screen",
      "expo-font"
    ],
    "scheme": "trackexpense",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f9d7801d-5779-4efb-8106-e05341679178"
      }
    },
    "owner": "dynnn"
  }
}
