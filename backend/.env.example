# Environment variables must be set by your shell or hosting service.
APP_ENV=development
DATABASE_URL=sqlite:///./track_expense.db
FRONTEND_ORIGIN=http://127.0.0.1:5176
# In production use a managed PostgreSQL URL and APP_ENV=production.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Google Cloud OAuth client of type Web application. Keep the secret server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI: FRONTEND_ORIGIN + /api/v1/auth/google/callback
